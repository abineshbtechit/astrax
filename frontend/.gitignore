# ===================================================================
# Frontend .gitignore (Node / React / Vite / TypeScript)
# ===================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production / Build outputs
dist/
dist-ssr/
build/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment files & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.local
!.env.example

# Testing / Coverage
coverage/
*.lcov
.nyc_output

# Editor & IDE directories
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini
